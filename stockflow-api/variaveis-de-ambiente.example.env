# ====================================================================
# 🔐 CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (TEMPLATE)
# ====================================================================
#
# INSTRUÇÕES DE USO:
# 1. Crie uma cópia deste arquivo na raiz do projeto.
# 2. Renomeie a cópia para ".env" (sem o .example).
# 3. Preencha as variáveis abaixo com suas credenciais reais.
#
# ⚠️ IMPORTANTE:
# O arquivo ".env" real já está no .gitignore.
# JAMAIS commite suas senhas ou chaves reais no GitHub!
# ====================================================================

# ====================================================================
# 🗄️ BANCO DE DADOS PRINCIPAL (stock-flow-db)
# ====================================================================
POSTGRES_DB=db_stockflow
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
DB_PORT=6061

# ====================================================================
# 🗄️ BANCO DE DADOS KEYCLOAK (db-keycloak-stock-flow)
# ====================================================================
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_senha

# ====================================================================
# 🔐 KEYCLOAK ADMIN (Acesso ao Painel)
# ====================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=senha_admin_keycloak

# ====================================================================
# 🔐 INTEGRAÇÃO SPRING BOOT <-> KEYCLOAK (stock-flow-api)
# ====================================================================
KEYCLOAK_URL=http://localhost:6062
KEYCLOAK_REALM=stock-flow-realm
KEYCLOAK_CLIENT_ID=stock-flow-api
KEYCLOAK_CLIENT_SECRET=seu_client_secret_gerado_no_keycloak

# ====================================================================
# 🚀 MENSAGERIA E CACHE (Dragonfly)
# ====================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:6063
REDIS_HOST=localhost
REDIS_PORT=6070

# ====================================================================
# 📊 OBSERVABILIDADE (LGTM Stack)
# ====================================================================
ZIPKIN_URL=http://localhost:6068/api/v2/spans
ENVIRONMENT=dev

# ====================================================================
# 🌐 CORS CONFIGURATION
# ====================================================================
API_CORS_ALLOWED_ORIGINS=http://localhost:4200