# ==========================================
# Estágio 1: Build
# ==========================================
FROM maven:3.9.6-eclipse-temurin-21-alpine AS builder

WORKDIR /app

# Cache de dependências — só rebaixa se pom.xml mudar
COPY pom.xml .
RUN mvn dependency:go-offline

# Compila sem testes
COPY src ./src
RUN mvn clean package -DskipTests

# ==========================================
# Estágio 2: Runtime
# ==========================================
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Timezone e encoding
ENV TZ=America/Sao_Paulo \
    JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"

# Usuário sem privilégios
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copia o jar do estágio anterior
COPY --from=builder /app/target/*.jar app.jar

# Define dono
RUN chown appuser:appgroup app.jar

# Roda como usuário sem privilégios
USER appuser

# Porta da aplicação (alinhar com application.yml)
EXPOSE 6060

# Health check via actuator - CORRIGIDO PARA A PORTA 6060
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:6060/actuator/health || exit 1

# JVM otimizada para container
ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:InitialRAMPercentage=50.0", \
  "-XX:+UseG1GC", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]